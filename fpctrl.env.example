# fpctrl MQTT configuration.
#
# Copy this file to fpctrl.env (same directory as fpctrl.py) and fill in
# your broker details. If MQTT_HOST is left unset or this file doesn't
# exist, MQTT publishing is silently skipped - it's optional.
#
# fpctrl.env should probably be gitignored if MQTT_PASSWORD is set, same
# as fireplace_state.json is runtime data rather than source.

# Required to enable MQTT publishing at all.
MQTT_HOST=CHANGEME
MQTT_CLIENT_ID=CHANGEME

# Optional - defaults shown.
#MQTT_PORT=1883
MQTT_USERNAME=CHANGEME
MQTT_PASSWORD=CHANGEME

# Failsafe - auto-shutoff after this amount of time in minutes
FIREPLACE_MAX_ON_MINUTES=60
