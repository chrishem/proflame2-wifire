[Unit]
Description=Proflame2 Fireplace MQTT Control Daemon
After=network-online.target npdaemon.service
Wants=network-online.target

[Service]
Type=simple
User=tech
Group=tech
WorkingDirectory=/home/tech/projects/wifire
ExecStart=/home/tech/projects/wifire/.venv/bin/python /home/tech/projects/wifire/fpctrl.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
